xpto = true;
xpto = 10;

// criando um tipo nosso. podemos usar a palavra type ou interface.
interface Pessoa{
    nome: string;
    idade: number;
}
// o tipo pessoa, é como se fosse(ingenuamente) uma struct que tem partes.
// cada parte a gente chama de propriedade de uma pessoa. (nesse caso)
// propriedade é uma caracteristica

interface Endereco{
    logradouro: string;
    numero?: number;
    // o simbolo ? torna essa propriedade opcional (nao precisa atribuir valor)
    complemento?: string;
    bairro: string;
    cidade: string;
    estado: string;
    cep: string;
}

let e: Endereco = {
    logradouro: "AV. Brasil",
    numero: 100,
    complemento: "",
    bairro: "Centro",
    cidade: "Campinas",
    estado: "SP",
    cep: "12334-123",
}

interface Pessoa {
    nome: string;
    idade: number;
    endereco: Endereco;
}

let joao: Pessoa = {
    nome: "João Pedro",
    idade: 20,
    endereco: e
}

console.log(joao)

