
// uma constante em JS/TS é definida da seguinte maneira:
// usamos a palavra const, depois o nome da constante e,
// imediatamente atribuimos o valor.
const pi = 3.1415;


const n = "Leonardo Silva";
// constante é imutável. portanto nao pode ser reatribuída
// n = "Leonardo Dionel Lima Silva";

// INFERÊNCIA DE TIPOS
const universidade = "PUC-Campinas";
// por inferência o TS percebe que, na primeira atribuição (no caso da constante é a unica)
// o tipo é uma string. portanto o typescript determina que uma constante uma vez atribuida
// com string nao muda (mas serve tambem para let e var)

// por inferência o TS define que a variavel idade é do tipo number.
// se você imediatamente inicializar:
let idade = 43;
// se eu tentar fazer a reatribuição nao funcionara
// idade = "queijo";
console.log(idade);

// definindo tipos explicitamente
let s: String;
s = "boa tarde!"


// boolean
let sol: Boolean = true;
